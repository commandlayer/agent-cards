{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commandlayer.org/agent-cards/schemas/v1.1.0/agent.card.schema.json",
  "title": "CommandLayer Agent Card Binding (v1.1.0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "owner",
    "ens",
    "version",
    "status",
    "class",
    "implements",
    "schemas",
    "schemas_mirror",
    "entry",
    "networks",
    "license",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://commandlayer.org/agent-cards/schemas/v1.1.0/agent.card.schema.json"
    },
    "$id": {
      "type": "string",
      "format": "uri"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+\\.eth$",
      "description": "Canonical ENS-bound agent identifier."
    },
    "owner": {
      "type": "string",
      "pattern": "^[a-z0-9-]+\\.eth$",
      "description": "ENS owner or publisher identity for the card binding."
    },
    "ens": {
      "type": "string",
      "pattern": "^[a-z0-9-]+\\.eth$",
      "description": "Canonical ENS name resolved by this card; must equal id in v1.1.0."
    },
    "version": {
      "type": "string",
      "const": "1.1.0"
    },
    "status": {
      "type": "string",
      "enum": [
        "protocol_reference",
        "active",
        "deprecated",
        "revoked"
      ],
      "description": "Lifecycle status for the binding, not a service-quality claim."
    },
    "class": {
      "type": "string",
      "enum": [
        "commons",
        "commercial"
      ]
    },
    "implements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "description": "Canonical verb binding; a v1.1.0 card binds exactly one verb."
    },
    "schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "receipt"
      ],
      "properties": {
        "request": {
          "type": "string",
          "format": "uri"
        },
        "receipt": {
          "type": "string",
          "format": "uri"
        }
      },
      "description": "Authoritative upstream request/receipt schema bindings."
    },
    "schemas_mirror": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "receipt"
      ],
      "properties": {
        "request": {
          "type": "string",
          "format": "uri"
        },
        "receipt": {
          "type": "string",
          "format": "uri"
        }
      },
      "description": "CommandLayer mirror URLs for the bound request/receipt schemas."
    },
    "entry": {
      "type": "string",
      "pattern": "^x402://[^/]+/[^/]+/v1\\.1\\.0$",
      "description": "Canonical semver-pinned x402 entry URI."
    },
    "networks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "Network identifiers required to interpret the entry binding."
    },
    "license": {
      "type": "string",
      "description": "License covering the card artifact."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Release provenance timestamp for initial publication of this card artifact."
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Release provenance timestamp for the latest card artifact update."
    }
  }
}
